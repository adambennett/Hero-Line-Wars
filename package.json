{
  "name": "hero-line-wars",
  "private": true,
  "version": "0.0.2",
  "description": "Hero Line Wars — WC3-style line wars prototype",
  "author": "Hero Line Wars",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pages": "tsc && vite build",
    "build:release": "tsc && vite build --mode singlefile",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "desktop": "electron .",
    "desktop:dev": "node tools/desktop-dev.mjs",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^7.0.2",
    "vite": "^7.1.7",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.herolinewars.game",
    "productName": "Hero Line Wars",
    "copyright": "Copyright © Hero Line Wars",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ],
      "category": "Game",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
